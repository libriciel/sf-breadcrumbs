{
    "name": "libriciel/ls-breadcrums",
    "description": "Un bundle \"Breadcrums\"",
    "type": "library",
    "require": {
        "symfony/event-dispatcher": "^7.2",
        "symfony/http-kernel": "^7.2",
        "twig/twig": "^3.16",
        "symfony/framework-bundle": "^7.2"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Libriciel\\LsBreadcrums\\": "src/",
            "Libriciel\\LsBreadcrums\\Tests": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eric Pommateau"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "symfony/test-pack": "^1.1"
    },

    "scripts": {
        "test": "phpunit --configuration phpunit.xml phpunit --bootstrap vendor/autoload.php tests/",
        "test-coverage": "phpunit --configuration phpunit.xml --coverage-text --coverage-clover coverage/coverage.xml --log-junit coverage/logfile.xml",
        "phpcs": "phpcs -ps --standard=PSR12 --ignore=vendor/ ./"
    }
}
