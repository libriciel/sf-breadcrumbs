{
    "name": "libriciel/sf-breadcrumbs",
    "description": "Un bundle de \"Breadcrumbs\" symfony fait par Libriciel",
    "type": "symfony-bundle",
    "version": "1.0.0",
    "require": {
        "php": ">=8.3",
        "symfony/event-dispatcher": "^7.2",
        "symfony/http-kernel": "^7.2",
        "twig/twig": "^3.16",
        "symfony/framework-bundle": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/validator": "^7.2"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Libriciel\\Breadcrumbs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Libriciel\\Breadcrumbs\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eric Pommateau"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist phpunit --bootstrap vendor/autoload.php tests/",
        "test-coverage": "phpunit --configuration phpunit.xml.dist --coverage-text --coverage-clover coverage/coverage.xml --log-junit coverage/logfile.xml",
        "phpcs": "phpcs -ps --standard=PSR12 --ignore=vendor/ ./"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/test-pack": "^1.1"
    }
}
