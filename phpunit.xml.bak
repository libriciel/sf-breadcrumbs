<?xml version="1.0" encoding="UTF-8"?>
<phpunit
        backupGlobals="false"
        stopOnFailure="false"
        bootstrap="vendor/autoload.php">


  <testsuites>
    <testsuite name="Ls Breadcrums - Tests suites">
      <directory>tests</directory>
    </testsuite>
  </testsuites>


  <filter>
    <whitelist>
      <directory suffix=".php">src</directory>
    </whitelist>
  </filter>


</phpunit>
